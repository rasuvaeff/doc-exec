#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;

        break;
    }
}

use Rasuvaeff\DocExec\Cli\Arguments;
use Rasuvaeff\DocExec\Cli\UsageError;
use Rasuvaeff\DocExec\DocExec;
use Rasuvaeff\DocExec\DocumentResult;
use Rasuvaeff\DocExec\Report\ConsoleReporter;

/** @var list<string> $argumentList */
$argumentList = array_slice($argv ?? [], 1);

try {
    $arguments = Arguments::parse($argumentList, getcwd() ?: '.');
} catch (UsageError $error) {
    fwrite(\STDERR, 'doc-exec: ' . $error->getMessage() . "\n\n" . Arguments::usage() . "\n");

    exit(2);
}

if ($arguments->wantsHelp) {
    echo Arguments::usage(), "\n";

    exit(0);
}

$docExec = new DocExec(bootstrap: $arguments->bootstrap, timeoutSeconds: $arguments->timeoutSeconds);
$reporter = new ConsoleReporter();

/** @var list<DocumentResult> $results */
$results = [];
$hadError = false;

foreach ($arguments->files as $file) {
    try {
        $results[] = $docExec->check($file);
    } catch (Throwable $exception) {
        fwrite(\STDERR, 'doc-exec: ' . $exception->getMessage() . "\n");
        $hadError = true;
    }
}

if ($results !== []) {
    echo $reporter->render($results), "\n";
}

$allPassed = array_reduce(
    $results,
    static fn(bool $carry, DocumentResult $result): bool => $carry && $result->passed(),
    initial: true,
);

exit($hadError || !$allPassed ? 1 : 0);
